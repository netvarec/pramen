---
// One shell for packaged and host-built editors. The integration selects the asset
// module before Vite builds its graph, so unused packaged files never enter it.
import { adminBasePath, adminConfigScript, adminHasPanels, adminLang, adminTitle } from "pramen:cms/admin";
import { assets } from "pramen:cms/admin-assets";
import { adminImportMap } from "@pramen/cms-astro";

export const prerender = false;
Astro.response.headers.set("cache-control", "private, no-store");
---

<!doctype html>
<html lang={adminLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{adminTitle}</title>
    <link rel="stylesheet" href={assets.css} />
    {adminHasPanels && (
      <script type="importmap" is:inline set:html={adminImportMap(assets)} />
    )}
    <script is:inline set:html={adminConfigScript} />
  </head>
  <body>
    <div id="app" data-base-path={adminBasePath}></div>
    <script is:inline type="module" src={assets.editor}></script>
  </body>
</html>
